# H5 production build variables. Copy to .env.production locally or on the build machine.
TARO_APP_APP_ID=taluo-h5
TARO_APP_PUBLIC_PATH=/
TARO_APP_SUPABASE_URL=https://<your-project-ref>.supabase.co
TARO_APP_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Used only by Supabase Edge Functions, never put this key in the H5 build.
# DASHSCOPE_API_KEY=<your-dashscope-api-key>
